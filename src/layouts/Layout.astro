---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Aaron Jay Lev - Full Stack AI Engineer</title>
		<meta name="description" content={description || "Full Stack AI Engineer with 20+ years of experience building scalable web platforms and AI automation systems. Expert in React, Node.js, Claude API, and healthcare SaaS. Founder of Lev Tech Corporation."} />
		<meta property="og:title" content={`${title} | Aaron Jay Lev - Full Stack AI Engineer`} />
		<meta property="og:description" content={description || "Full Stack AI Engineer with 20+ years of experience building scalable web platforms and AI automation systems. Expert in React, Node.js, Claude API, and healthcare SaaS."} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://aaronjaylev.com" />
		<meta property="og:image" content="https://aaronjaylev.com/img/aaron-lev-headshot.jpg" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={`${title} | Aaron Jay Lev - Full Stack AI Engineer`} />
		<meta name="twitter:description" content={description || "Full Stack AI Engineer with 20+ years of experience building scalable web platforms and AI automation systems."} />
		<meta name="twitter:image" content="https://aaronjaylev.com/img/aaron-lev-headshot.jpg" />
		<link rel="canonical" href="https://aaronjaylev.com" />

		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
		<link rel="manifest" href="/site.webmanifest">
				
		<!-- Google tag (gtag.js) -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-6H8RKFXRHP"></script>
		<script is:inline>
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  gtag('js', new Date());

		  gtag('config', 'G-6H8RKFXRHP');
		</script>

		<!-- Schema.org Structured Data -->
		<script is:inline type="application/ld+json">
		{
		  "@context": "https://schema.org",
		  "@type": "Person",
		  "name": "Aaron Jay Lev",
		  "url": "https://aaronjaylev.com",
		  "image": "https://aaronjaylev.com/img/aaron-lev-headshot.jpg",
		  "email": "aaronjaylev@gmail.com",
		  "telephone": "+1-561-239-6941",
		  "jobTitle": "Senior Full Stack AI Engineer",
		  "worksFor": {
		    "@type": "Organization",
		    "name": "Lev Tech Corporation",
		    "url": "https://levtechcorp.com"
		  },
		  "sameAs": [
		    "https://www.linkedin.com/in/aaronjaylev",
		    "https://github.com/aaronjaylev",
		    "https://x.com/aaronjaylev"
		  ],
		  "knowsAbout": [
		    "Full Stack Development",
		    "AI Engineering",
		    "Claude API",
		    "React",
		    "Node.js",
		    "TypeScript",
		    "Healthcare SaaS",
		    "AI Automation",
		    "Lead Generation",
		    "PostgreSQL",
		    "Astro",
		    "Next.js"
		  ],
		  "hasOccupation": {
		    "@type": "Occupation",
		    "name": "Software Engineer",
		    "qualifications": "BS Computer Science, University of Maryland College Park"
		  },
		  "award": "US Patent 7,916,844 - System and Method to Determine and Deliver Quotes for Distance Sensitive Communication Links"
		}
		</script>

		<script is:inline type="application/ld+json">
		{
		  "@context": "https://schema.org",
		  "@type": "Organization",
		  "name": "Lev Tech Corporation",
		  "url": "https://levtechcorp.com",
		  "founder": {
		    "@type": "Person",
		    "name": "Aaron Jay Lev"
		  },
		  "knowsAbout": [
		    "AI Automation",
		    "Lead Generation Systems",
		    "Healthcare Marketing",
		    "Web Development",
		    "SaaS Solutions"
		  ],
		  "sameAs": [
		    "https://levtechcorp.com"
		  ]
		}
		</script>
		<style>
			@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

			:root {
				--gradient-primary: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
				--gradient-accent: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
			}

			* {
				font-family: 'Inter', sans-serif;
			}

			body {
				background-color: #0f1419;
				color: #e0e7ff;
			}
		</style>
	</head>
	<body class="bg-slate-950 text-slate-100">
		<nav class="sticky top-0 z-50 backdrop-blur-md bg-slate-950/80 border-b border-slate-800">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex justify-between items-center py-4">
					<a href="/" class="text-2xl font-bold bg-gradient-to-r from-blue-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">
						Aaron Jay Lev
					</a>
					<div class="flex gap-8 items-center">
						<a href="#projects" class="text-slate-300 hover:text-blue-400 transition">Projects</a>
						<a href="#skills" class="text-slate-300 hover:text-blue-400 transition">Skills</a>
						<a href="#contact" class="text-slate-300 hover:text-blue-400 transition">Contact</a>
						<button class="px-6 py-2 bg-gradient-to-r from-blue-500 to-purple-600 text-white font-semibold rounded-lg hover:shadow-lg hover:shadow-purple-500/50 transition">
							Get in Touch
						</button>
					</div>
				</div>
			</div>
		</nav>

		<slot />

		<footer class="bg-slate-900 border-t border-slate-800 mt-20">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
				<div class="grid grid-cols-3 gap-12 mb-8">
					<div>
						<h3 class="text-lg font-semibold mb-4 text-blue-400">Aaron Jay Lev</h3>
						<p class="text-slate-400 text-sm">Building modern web experiences with cutting-edge technology.</p>
					</div>
					<div>
						<h4 class="font-semibold mb-4 text-slate-200">Links</h4>
						<ul class="space-y-2 text-sm text-slate-400">
							<li><a href="#" class="hover:text-blue-400 transition">GitHub</a></li>
							<li><a href="#" class="hover:text-blue-400 transition">LinkedIn</a></li>
							<li><a href="#" class="hover:text-blue-400 transition">Twitter</a></li>
						</ul>
					</div>
					<div>
						<h4 class="font-semibold mb-4 text-slate-200">Contact</h4>
						<p class="text-sm text-slate-400">hello@aaronjaylev.com</p>
					</div>
				</div>
				<div class="border-t border-slate-800 pt-8">
					<p class="text-center text-slate-500 text-sm">&copy; 2026 Aaron Jay Lev. All rights reserved.</p>
				</div>
			</div>
		</footer>
	</body>
</html>

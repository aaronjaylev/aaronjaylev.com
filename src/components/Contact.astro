---
import { person, socialLinks } from '../config/site';
---

<!-- CTA Section -->
<section id="contact" class="py-20 px-4">
	<div class="max-w-4xl mx-auto">
		<div class="rounded-2xl border border-purple-500/30 bg-gradient-to-br from-purple-900/20 to-blue-900/20 backdrop-blur p-12 text-center">
			<h2 class="text-4xl font-bold mb-4">Let's Build Something Great Together</h2>
			<p class="text-lg text-slate-300 mb-8">I'm available for AI engineering roles and ambitious full-stack projects. Let's discuss how I can drive impact for your team.</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<a href={socialLinks.linkedin} target="_blank" class="px-8 py-3 bg-gradient-to-r from-blue-500 to-purple-600 text-white font-semibold rounded-lg hover:shadow-lg hover:shadow-purple-500/50 transition transform hover:scale-105 inline-block">
					Connect on LinkedIn
				</a>
				<a href={`mailto:${person.email}`} class="px-8 py-3 border border-slate-600 text-slate-200 font-semibold rounded-lg hover:border-purple-500 hover:text-purple-400 transition inline-block">
					Send me an Email
				</a>
			</div>
		</div>
	</div>
</section>

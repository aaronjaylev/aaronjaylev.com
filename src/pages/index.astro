---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
	<!-- Hero Section -->
	<section class="min-h-[calc(100vh-80px)] flex items-center justify-center px-4 relative overflow-hidden">
		<div class="absolute inset-0 overflow-hidden">
			<div class="absolute -top-40 -right-40 w-80 h-80 bg-blue-500/10 rounded-full blur-3xl"></div>
			<div class="absolute -bottom-40 -left-40 w-80 h-80 bg-purple-500/10 rounded-full blur-3xl"></div>
		</div>
		<div class="relative z-10 max-w-5xl mx-auto">
			<div class="grid md:grid-cols-2 gap-12 items-center">
				<!-- Left: Text Content -->
				<div class="text-center md:text-left">
					<div class="inline-block mb-6 px-4 py-2 rounded-full border border-purple-500/30 bg-purple-500/10 backdrop-blur">
						<span class="text-purple-300 text-sm font-medium">Welcome to my portfolio</span>
					</div>
					<h1 class="text-5xl md:text-6xl font-bold mb-6 leading-tight">
						Craft Digital
						<span class="bg-gradient-to-r from-blue-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">
							Experiences
						</span>
					</h1>
					<p class="text-lg md:text-xl text-slate-300 mb-12 leading-relaxed">
						I build modern, scalable web applications that solve real problems. Full-stack engineer passionate about clean code and beautiful design.
					</p>
					<div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start items-center">
						<button class="px-8 py-3 bg-gradient-to-r from-blue-500 to-purple-600 text-white font-semibold rounded-lg hover:shadow-lg hover:shadow-purple-500/50 transition transform hover:scale-105">
							View My Work
						</button>
						<button class="px-8 py-3 border border-slate-600 text-slate-200 font-semibold rounded-lg hover:border-purple-500 hover:text-purple-400 transition">
							Download Resume
						</button>
					</div>
				</div>

				<!-- Right: Image -->
				<div class="flex justify-center md:justify-end">
					<div class="relative max-w-sm">
						<!-- Glow effect -->
						<div class="absolute -inset-4 bg-gradient-to-r from-blue-500 via-purple-500 to-pink-500 rounded-3xl blur-2xl opacity-20 animate-pulse"></div>
						<!-- Image container -->
						<div class="relative rounded-3xl overflow-hidden border-2 border-purple-500/30" style="max-width: 250px;">
							<img
								src="/img/aaron-lev-headshot.jpg"
								alt="Aaron Jay Lev"
								class="w-full h-auto object-contain"
							/>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Featured Projects -->
	<section id="projects" class="py-20 px-4 relative">
		<div class="max-w-6xl mx-auto">
			<div class="text-center mb-16">
				<h2 class="text-4xl md:text-5xl font-bold mb-4">Featured Projects</h2>
				<p class="text-slate-400 text-lg">Showcasing some of my recent work and explorations</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
				<!-- Project Card 1 -->
				<div class="group relative rounded-2xl border border-slate-700 bg-slate-900/50 backdrop-blur hover:border-purple-500 transition overflow-hidden">
					<div class="absolute inset-0 bg-gradient-to-br from-purple-500/10 to-blue-500/10 opacity-0 group-hover:opacity-100 transition"></div>
					<div class="relative p-8">
						<div class="w-12 h-12 mb-4 rounded-lg bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center">
							<span class="text-xl">🚀</span>
						</div>
						<h3 class="text-2xl font-bold mb-2">Project Alpha</h3>
						<p class="text-slate-400 mb-6">A lightning-fast SaaS application built with React and Node.js that helps teams collaborate in real-time with 99.9% uptime.</p>
						<div class="flex flex-wrap gap-2 mb-6">
							<span class="px-3 py-1 rounded-full text-sm bg-blue-500/20 text-blue-300 border border-blue-500/30">React</span>
							<span class="px-3 py-1 rounded-full text-sm bg-purple-500/20 text-purple-300 border border-purple-500/30">TypeScript</span>
							<span class="px-3 py-1 rounded-full text-sm bg-pink-500/20 text-pink-300 border border-pink-500/30">PostgreSQL</span>
						</div>
						<a href="#" class="inline-flex items-center text-purple-400 hover:text-purple-300 transition">
							View Project →
						</a>
					</div>
				</div>

				<!-- Project Card 2 -->
				<div class="group relative rounded-2xl border border-slate-700 bg-slate-900/50 backdrop-blur hover:border-purple-500 transition overflow-hidden">
					<div class="absolute inset-0 bg-gradient-to-br from-purple-500/10 to-blue-500/10 opacity-0 group-hover:opacity-100 transition"></div>
					<div class="relative p-8">
						<div class="w-12 h-12 mb-4 rounded-lg bg-gradient-to-br from-green-500 to-emerald-600 flex items-center justify-center">
							<span class="text-xl">⚡</span>
						</div>
						<h3 class="text-2xl font-bold mb-2">Analytics Dashboard</h3>
						<p class="text-slate-400 mb-6">Real-time analytics platform providing actionable insights to over 10,000+ businesses with interactive visualizations.</p>
						<div class="flex flex-wrap gap-2 mb-6">
							<span class="px-3 py-1 rounded-full text-sm bg-green-500/20 text-green-300 border border-green-500/30">D3.js</span>
							<span class="px-3 py-1 rounded-full text-sm bg-blue-500/20 text-blue-300 border border-blue-500/30">Next.js</span>
							<span class="px-3 py-1 rounded-full text-sm bg-yellow-500/20 text-yellow-300 border border-yellow-500/30">Python</span>
						</div>
						<a href="#" class="inline-flex items-center text-purple-400 hover:text-purple-300 transition">
							View Project →
						</a>
					</div>
				</div>

				<!-- Project Card 3 -->
				<div class="group relative rounded-2xl border border-slate-700 bg-slate-900/50 backdrop-blur hover:border-purple-500 transition overflow-hidden">
					<div class="absolute inset-0 bg-gradient-to-br from-purple-500/10 to-blue-500/10 opacity-0 group-hover:opacity-100 transition"></div>
					<div class="relative p-8">
						<div class="w-12 h-12 mb-4 rounded-lg bg-gradient-to-br from-orange-500 to-red-600 flex items-center justify-center">
							<span class="text-xl">🎨</span>
						</div>
						<h3 class="text-2xl font-bold mb-2">Design System</h3>
						<p class="text-slate-400 mb-6">Comprehensive open-source design system and component library used by companies to accelerate their UI development.</p>
						<div class="flex flex-wrap gap-2 mb-6">
							<span class="px-3 py-1 rounded-full text-sm bg-orange-500/20 text-orange-300 border border-orange-500/30">Storybook</span>
							<span class="px-3 py-1 rounded-full text-sm bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">CSS</span>
							<span class="px-3 py-1 rounded-full text-sm bg-red-500/20 text-red-300 border border-red-500/30">Figma</span>
						</div>
						<a href="#" class="inline-flex items-center text-purple-400 hover:text-purple-300 transition">
							View Project →
						</a>
					</div>
				</div>

				<!-- Project Card 4 -->
				<div class="group relative rounded-2xl border border-slate-700 bg-slate-900/50 backdrop-blur hover:border-purple-500 transition overflow-hidden">
					<div class="absolute inset-0 bg-gradient-to-br from-purple-500/10 to-blue-500/10 opacity-0 group-hover:opacity-100 transition"></div>
					<div class="relative p-8">
						<div class="w-12 h-12 mb-4 rounded-lg bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center">
							<span class="text-xl">🔧</span>
						</div>
						<h3 class="text-2xl font-bold mb-2">DevTools CLI</h3>
						<p class="text-slate-400 mb-6">Command-line tool that streamlines development workflows, reducing deployment time by 60% for distributed teams.</p>
						<div class="flex flex-wrap gap-2 mb-6">
							<span class="px-3 py-1 rounded-full text-sm bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">Go</span>
							<span class="px-3 py-1 rounded-full text-sm bg-blue-500/20 text-blue-300 border border-blue-500/30">Bash</span>
							<span class="px-3 py-1 rounded-full text-sm bg-slate-500/20 text-slate-300 border border-slate-500/30">Docker</span>
						</div>
						<a href="#" class="inline-flex items-center text-purple-400 hover:text-purple-300 transition">
							View Project →
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Tech Stack -->
	<section id="skills" class="py-20 px-4 relative">
		<div class="max-w-6xl mx-auto">
			<div class="text-center mb-16">
				<h2 class="text-4xl md:text-5xl font-bold mb-4">Tech Stack & Skills</h2>
				<p class="text-slate-400 text-lg">Tools and technologies I work with daily</p>
			</div>

			<div class="grid grid-cols-2 md:grid-cols-4 gap-6">
				<div class="rounded-xl border border-slate-700 bg-slate-900/50 p-6 text-center hover:border-blue-500 transition">
					<div class="text-3xl mb-3">⚛️</div>
					<h3 class="font-semibold text-slate-100">React & Next.js</h3>
					<p class="text-sm text-slate-400 mt-1">Frontend</p>
				</div>
				<div class="rounded-xl border border-slate-700 bg-slate-900/50 p-6 text-center hover:border-blue-500 transition">
					<div class="text-3xl mb-3">🔷</div>
					<h3 class="font-semibold text-slate-100">TypeScript</h3>
					<p class="text-sm text-slate-400 mt-1">Language</p>
				</div>
				<div class="rounded-xl border border-slate-700 bg-slate-900/50 p-6 text-center hover:border-blue-500 transition">
					<div class="text-3xl mb-3">🟢</div>
					<h3 class="font-semibold text-slate-100">Node.js</h3>
					<p class="text-sm text-slate-400 mt-1">Backend</p>
				</div>
				<div class="rounded-xl border border-slate-700 bg-slate-900/50 p-6 text-center hover:border-blue-500 transition">
					<div class="text-3xl mb-3">🐘</div>
					<h3 class="font-semibold text-slate-100">PostgreSQL</h3>
					<p class="text-sm text-slate-400 mt-1">Database</p>
				</div>
				<div class="rounded-xl border border-slate-700 bg-slate-900/50 p-6 text-center hover:border-blue-500 transition">
					<div class="text-3xl mb-3">🔵</div>
					<h3 class="font-semibold text-slate-100">GraphQL</h3>
					<p class="text-sm text-slate-400 mt-1">API</p>
				</div>
				<div class="rounded-xl border border-slate-700 bg-slate-900/50 p-6 text-center hover:border-blue-500 transition">
					<div class="text-3xl mb-3">🐳</div>
					<h3 class="font-semibold text-slate-100">Docker & K8s</h3>
					<p class="text-sm text-slate-400 mt-1">DevOps</p>
				</div>
				<div class="rounded-xl border border-slate-700 bg-slate-900/50 p-6 text-center hover:border-blue-500 transition">
					<div class="text-3xl mb-3">⚡</div>
					<h3 class="font-semibold text-slate-100">AWS</h3>
					<p class="text-sm text-slate-400 mt-1">Cloud</p>
				</div>
				<div class="rounded-xl border border-slate-700 bg-slate-900/50 p-6 text-center hover:border-blue-500 transition">
					<div class="text-3xl mb-3">🎨</div>
					<h3 class="font-semibold text-slate-100">Tailwind CSS</h3>
					<p class="text-sm text-slate-400 mt-1">Styling</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Stats Section -->
	<section class="py-20 px-4">
		<div class="max-w-6xl mx-auto">
			<div class="grid grid-cols-2 md:grid-cols-4 gap-8">
				<div class="text-center">
					<div class="text-4xl md:text-5xl font-bold text-transparent bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text">50+</div>
					<p class="text-slate-400 mt-2">Projects Completed</p>
				</div>
				<div class="text-center">
					<div class="text-4xl md:text-5xl font-bold text-transparent bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text">8+</div>
					<p class="text-slate-400 mt-2">Years Experience</p>
				</div>
				<div class="text-center">
					<div class="text-4xl md:text-5xl font-bold text-transparent bg-gradient-to-r from-pink-400 to-blue-400 bg-clip-text">15+</div>
					<p class="text-slate-400 mt-2">Clients Served</p>
				</div>
				<div class="text-center">
					<div class="text-4xl md:text-5xl font-bold text-transparent bg-gradient-to-r from-blue-400 to-green-400 bg-clip-text">100%</div>
					<p class="text-slate-400 mt-2">Satisfaction Rate</p>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section id="contact" class="py-20 px-4">
		<div class="max-w-4xl mx-auto">
			<div class="rounded-2xl border border-purple-500/30 bg-gradient-to-br from-purple-900/20 to-blue-900/20 backdrop-blur p-12 text-center">
				<h2 class="text-4xl font-bold mb-4">Ready to work together?</h2>
				<p class="text-lg text-slate-300 mb-8">Let's discuss your next project and bring your ideas to life.</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<button class="px-8 py-3 bg-gradient-to-r from-blue-500 to-purple-600 text-white font-semibold rounded-lg hover:shadow-lg hover:shadow-purple-500/50 transition transform hover:scale-105">
						Start a Project
					</button>
					<button class="px-8 py-3 border border-slate-600 text-slate-200 font-semibold rounded-lg hover:border-purple-500 hover:text-purple-400 transition">
						Send me an Email
					</button>
				</div>
			</div>
		</div>
	</section>
</Layout>
